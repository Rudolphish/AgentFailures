{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-failures-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Supabase の無料プランは 7 日間 DB アクセスが無いとプロジェクトが自動停止するため、
  // 定期的に keepalive_log へ追記して停止を回避する。
  //
  // 「1,4」は日曜と水曜である。月曜と木曜ではない。
  // Cloudflare の cron は曜日を 1 始まりで数え、1 が日曜である
  // （SUN=1 / MON=2 / TUE=3 / WED=4 / THU=5 / FRI=6 / SAT=7）。
  // 一般的な Unix cron の 0=日曜とは 1 つずれる。
  // 根拠: cloudflare/saffron の saffron/src/parse.rs の dow_expr のテスト。
  // 実際の発火日はダッシュボードの Settings → Trigger Events にも表示される。
  //
  // 発火間隔は 日→水 が 3 日、水→日 が 4 日で、最大 4 日となり閾値を下回る。
  // 曜日を変更する場合、この番号付けを踏まえて間隔が 7 日未満に収まることを
  // 確認すること。
  "triggers": {
    "crons": ["0 3 * * 1,4"]
  }
}
