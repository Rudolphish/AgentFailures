{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-failures-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Cron から keepalive_log へ 1 行追記する。
  //
  // **これは自動停止の対策ではない。** Supabase 無料プランの判定基準は
  // 「7 日以上にわたり十分な活動量が無いこと」であり、アクセスの間隔ではない。
  // この keep-alive を入れたうえで 2026-10-29 と 2026-11-11 に停止している。
  // 残している目的は切り分けで、select max(ran_at) で最後に書き込めた時刻が分かる。
  // 詳細は README の「Supabase の自動停止」。
  //
  // 「1,4」は日曜と水曜である。月曜と木曜ではない。
  // Cloudflare の cron は曜日を 1 始まりで数え、1 が日曜である
  // （SUN=1 / MON=2 / TUE=3 / WED=4 / THU=5 / FRI=6 / SAT=7）。
  // 一般的な Unix cron の 0=日曜とは 1 つずれる。
  // 根拠: cloudflare/saffron の saffron/src/parse.rs の dow_expr のテスト。
  // 実際の発火日はダッシュボードの Settings → Trigger Events にも表示される。
  //
  // 発火間隔は 日→水 が 3 日、水→日 が 4 日である。
  // **間隔を詰めても自動停止は防げない**（上記のとおり判定は活動量である）。
  // 曜日を変更する場合に確認すべきは間隔ではなく、この番号付けを踏まえて
  // 意図した曜日になっているか（ダッシュボードの Trigger Events の文章表示）である。
  "triggers": {
    "crons": ["0 3 * * 1,4"]
  }
}
