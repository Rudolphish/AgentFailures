{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(*wrangler secret*)",
      "Bash(*wrangler delete*)",
      "Bash(*supabase db reset*)",
      "Bash(*supabase projects delete*)",
      "Bash(*SUPABASE_SERVICE_ROLE_KEY=*)",
      "Bash(*git push --force*)",
      "Bash(*git push*--force*)",
      "Bash(*git push -f*)",
      "Edit(.dev.vars)",
      "Edit(**/.dev.vars)",
      "Edit(.env)",
      "Edit(**/.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-review.mjs\" --record-session-base",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-brief.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-review.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
